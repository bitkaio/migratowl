# =============================================================================
# Migratowl — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines starting with # are comments. Uncomment and set as needed.

# =============================================================================
# Third-party API keys (read directly by their SDKs — no MIGRATOWL_ prefix)
# =============================================================================

# Anthropic — required when MIGRATOWL_MODEL_PROVIDER=anthropic (default)
ANTHROPIC_API_KEY=

# OpenAI — required when MIGRATOWL_MODEL_PROVIDER=openai
# OPENAI_API_KEY=

# GitHub — optional, increases API rate limits for changelog fetching;
# also needed to post PR comments and commit statuses (repo:status, public_repo scopes)
# GITHUB_TOKEN=   # also clones private GitHub repositories
# GITHUB_API_URL=https://api.github.com

# GitLab — optional, needed to post MR comments and commit statuses (api scope)
# GITLAB_TOKEN=   # also clones private GitLab repositories
# GITLAB_API_URL=https://gitlab.com/api/v4

# LangFuse — optional, for observability/tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Migratowl settings (all prefixed with MIGRATOWL_)
# =============================================================================

# LLM provider: "anthropic" (default), "openai", or "litellm"
# MIGRATOWL_MODEL_PROVIDER=anthropic

# LLM model name (must match the selected provider)
# MIGRATOWL_MODEL_NAME=claude-sonnet-5-5

# LLM — max requests/second (0.1 = 6 req/min)
# MIGRATOWL_MODEL_RATE_LIMIT_RPS=0.1

# =============================================================================
# LLM Proxy Configuration (optional)
# =============================================================================
# For developers using internal LLM proxies (LiteLLM, Azure API Management, etc.)
# See docs/proxy-setup.md for detailed configuration examples.

# LiteLLM unified endpoint — OpenAI-compatible API that routes to any provider
# Set MIGRATOWL_MODEL_PROVIDER=litellm to use this endpoint
# LITELLM_BASE_URL=http://localhost:6655/litellm/v1

# Provider-specific proxy base URLs (alternative to LiteLLM)
# ANTHROPIC_BASE_URL=https://proxy.example.com/anthropic/v1
# OPENAI_BASE_URL=https://proxy.example.com/openai/v1

# Model alias — override model name if proxy uses different naming conventions
# Example: Your proxy expects "anthropic--claude-sonnet-latest" but you want to
# keep "claude-sonnet-5-5" as the default for direct API access
# MIGRATOWL_MODEL_ALIAS=anthropic--claude-sonnet-latest

# Kubernetes sandbox — mode: "agent-sandbox" (requires controller + CRDs) or "raw" (any cluster)
# MIGRATOWL_SANDBOX_MODE=agent-sandbox

# Kubernetes sandbox — template name for agent-sandbox mode
# MIGRATOWL_SANDBOX_TEMPLATE=migratowl-sandbox-template

# Kubernetes sandbox — namespace to create sandboxes in
# MIGRATOWL_SANDBOX_NAMESPACE=default

# Kubernetes sandbox — connection mode (tunnel | direct); agent-sandbox mode only
# MIGRATOWL_SANDBOX_CONNECTION_MODE=tunnel

# Kubernetes sandbox — sandbox-router URL, required with connection mode "direct" (server running in the cluster)
# MIGRATOWL_SANDBOX_API_URL=http://sandbox-router-svc.default.svc.cluster.local:8080

# Kubernetes API for SandboxClaim cleanup (agent-sandbox mode). Off-cluster: run `kubectl proxy`
# MIGRATOWL_SANDBOX_KUBE_API_URL=http://localhost:8001
# MIGRATOWL_SANDBOX_KUBE_TOKEN=

# Kubernetes sandbox — container image for raw mode (must include git and the target ecosystems' toolchains)
# MIGRATOWL_SANDBOX_IMAGE=ghcr.io/bitkaio/migratowl-runtime:latest

# Kubernetes sandbox — attach deny-all NetworkPolicy in raw mode (requires Calico/Cilium)
# MIGRATOWL_SANDBOX_BLOCK_NETWORK=true

# Python version in the sandbox image; PyPI releases that require a newer Python are skipped
# MIGRATOWL_SANDBOX_PYTHON_VERSION=3.13

# Path inside the sandbox where repositories are cloned
# MIGRATOWL_WORKSPACE_PATH=/home/user/workspace

# Max concurrent registry queries when checking for outdated dependencies
# MIGRATOWL_SCAN_REGISTRY_CONCURRENCY=10

# Analysis — packages above this confidence are analyzed directly; below → subagent
# MIGRATOWL_CONFIDENCE_THRESHOLD=0.7

# Analysis — truncation limit for sandbox command output fed to the LLM
# MIGRATOWL_MAX_OUTPUT_CHARS=30000

# Analysis — characters of failing build/test output (tail) given to the LLM in its brief
# MIGRATOWL_ANALYSIS_TAIL_CHARS=4000

# Analysis — truncation limit for fetched changelogs
# MIGRATOWL_MAX_CHANGELOG_CHARS=15000

# Analysis — hard cap on registry scan results
# MIGRATOWL_MAX_OUTDATED_DEPS=100

# Jobs — "sqlite" keeps jobs and agent checkpoints on disk so scans survive a restart
# (resume with POST /jobs/{id}/resume); "memory" keeps nothing (CI, one-shot runs)
# MIGRATOWL_PERSISTENCE_BACKEND=sqlite
# MIGRATOWL_JOBS_DB_PATH=./migratowl_jobs.db
# MIGRATOWL_CHECKPOINT_DB_PATH=./migratowl_checkpoints.db

# Jobs — how often a job may be resumed before it is marked failed
# MIGRATOWL_MAX_SCAN_RETRIES=3

# Jobs — scans that run at once (each has its own sandbox pod); the rest wait as pending
# MIGRATOWL_MAX_CONCURRENT_SCANS=1

# Sandboxes idle longer than this are deleted by the startup sweep; the absolute TTL is unset by default
# MIGRATOWL_SANDBOX_TTL_IDLE_SECONDS=1800
# MIGRATOWL_SANDBOX_TTL_SECONDS=

# Log level for Migratowl's own messages (DEBUG, INFO, WARNING, ERROR)
# MIGRATOWL_LOG_LEVEL=INFO

# API security — when set, /webhook and /jobs* require "Authorization: Bearer <token>".
# Set it whenever the server is reachable from anything but localhost.
# MIGRATOWL_API_TOKEN=
# Allow callback_url to target private/loopback/link-local addresses (local development only)
# MIGRATOWL_CALLBACK_ALLOW_PRIVATE=false

# API server — bind address / port
# MIGRATOWL_API_HOST=0.0.0.0
# MIGRATOWL_API_PORT=8000

# HTTP client — timeout in seconds for outbound requests
# MIGRATOWL_HTTP_TIMEOUT=30.0

# HTTP client — number of retries on 429/5xx responses
# MIGRATOWL_HTTP_RETRY_COUNT=3

# HTTP client — base delay (seconds) for exponential backoff between retries
# MIGRATOWL_HTTP_RETRY_BACKOFF_BASE=0.5
